# ── Website ────────────────────────────────────────────────
PORT=3000
# Public address of the site (used for links inside Discord messages). Example: https://rein1v1.com
PUBLIC_URL=
# Password for the admin panel (use 12+ characters)
ADMIN_PASSWORD=change-me
# Hidden address of the admin panel, e.g. admin-7f3k9q2x → http://your-site/admin-7f3k9q2x
# Leave empty and a random one is created and printed when the server starts. /admin itself does not exist.
ADMIN_PATH=
# Optional: fixed secret for admin sessions (auto-generated if empty)
SESSION_SECRET=
# Behind a reverse proxy: true (one proxy, e.g. Caddy/nginx) or a number (2 = Cloudflare + Caddy)
TRUST_PROXY=false
# Listen address. Empty = all; 127.0.0.1 = only the proxy on the same machine can reach it
HOST=
# Daily database backups kept in data/backups
BACKUP_KEEP=14
# Server only (Docker/Caddy): the site's domain
# DOMAIN=rein1v1.com

# ── Discord bot ────────────────────────────────────────────
# Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# true = instant name/avatar updates (enable "Server Members Intent" in the portal first)
DISCORD_MEMBERS_INTENT=false

# Initial values — all of these can be changed later from Admin → Discord
DISCORD_GUILD_ID=
DISCORD_REGISTRATION_CHANNEL_ID=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_RESULTS_CHANNEL_ID=
DISCORD_PLAYER_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=
